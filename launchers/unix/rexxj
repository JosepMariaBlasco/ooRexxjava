#!/bin/sh
# rexxj: the launcher (README.md); build.sh copies it into dist/.
# -Xss: Java threads the module did not create (Swing's, a pool's) may enter it, and
# Endive's frames live on their Java stack (prototypes/threads/README.md)
# -cp, not -jar: Java code that Rexx uses is found through CLASSPATH, as with BSF4ooRexx;
# the jar is also the agent that gives BSF4ooRexx's native methods to the module (Natives)
# $REXXJ_JAVA_OPTIONS: more options for the JVM, e.g. -XX:-DontCompileHugeMethods for long
# runs (README.md, "Speed")
# $REXXJ_SERVER: run the program in a warm JVM through rexxjs, the native client of
# rexxjvm.Server (client/rexxjs.c; README.md, "A warm JVM: rexxjs"), if it was built
D=$(dirname "$(readlink -f "$0")")
# Options by the version of the java in PATH, from its release file (none: no options):
# Java 23 and later, allow sun.misc.Unsafe (FlatMemory) without JDK 24+'s warning on every
# run (JEP 498), older ones refuse the option; Java 27 and later, C2 inlines on past its
# node cutoff (DelayAfterInliningCutoff, diagnostic: README.md, "Speed"), older ones do
# not know it. $REXXJ_JVM_FLAGS hands them to rexxjs for the server's JVM.
UNSAFE= DELAY= V=
J=$(command -v java) && R=$(dirname "$(dirname "$(readlink -f "$J")")")/release && [ -f "$R" ] &&
  V=$(sed -n 's/^JAVA_VERSION="\([0-9]*\).*/\1/p' "$R")
[ "${V:-0}" -ge 23 ] 2>/dev/null && UNSAFE=--sun-misc-unsafe-memory-access=allow
[ "${V:-0}" -ge 27 ] 2>/dev/null && DELAY="-XX:+UnlockDiagnosticVMOptions -XX:+DelayAfterInliningCutoff"
REXXJ_JVM_FLAGS="$UNSAFE $DELAY"; export REXXJ_JVM_FLAGS
[ -n "$REXXJ_SERVER" ] && [ -x "$D/rexxjs" ] && exec "$D/rexxjs" "$@"
PATH="$D:$PATH" exec java -Xss16m $UNSAFE $DELAY $REXXJ_JAVA_OPTIONS -Drexxjvm.executable="$D/rexx" -Drexxjvm.home="$D" -javaagent:"$D/rexxj.jar" -cp "$D/rexxj.jar:$D/bsf4oorexx.jar${CLASSPATH:+:$CLASSPATH}" rexxjvm.RunWasm "$@"
