@@ -270,6 +270,66 @@ abstract class FlatMemory implements Memory {
     @Override public long readF64(int addr) { return readLong(addr); }
     @Override public void writeF64(int addr, double data) { writeLong(addr, Double.doubleToRawLongBits(data)); }
 
+    // ---- plain accesses at a 64-bit effective address (LongAddr) ----------------------------
+
+    /*
+     * The same accesses, given WebAssembly's effective address: the i32 address
+     * zero-extended plus the access's offset, computed in long (no wrap-around), instead
+     * of Endive's getAddr (the int sum, or the address itself if negative). C2 does
+     * better with long address arithmetic (JDK-8397094); LongAddr is what the translated
+     * code calls when its helpers are rewritten (prototypes/memory-bench, "Addresses in
+     * long"). An effective address past 2 GB traps as getAddr's negative one does.
+     */
+
+    /** The offset of a plain access of n <= 8 bytes at ea; the relaxed subclasses override it. */
+    long atL(long ea, int n) {
+        return atStrictL(ea, n);
+    }
+
+    /** The relaxed check: below 2 GB, the guard covering the rest (see above). */
+    final long atRelaxedL(long ea, int n) {
+        return ea < 0x8000_0000L ? ea : atStrictL(ea, n);
+    }
+
+    /** The offset of an access of n bytes at ea; traps if out of bounds. */
+    final long atStrictL(long ea, int n) {
+        if (ea > (long) limit - n) return atSlowL(ea, n);
+        return ea;
+    }
+
+    private long atSlowL(long ea, int n) {
+        int lim = nPages * PAGE_SIZE;
+        if (ea > (long) lim - n)
+            throw new WasmRuntimeException("out of bounds memory access: attempted to access address: "
+                + ea + " but limit is: " + lim + " and size: " + n);
+        limit = lim;
+        return ea;
+    }
+
+    final byte readL(long ea) { return getByte(atL(ea, 1)); }
+    final void writeByteL(long ea, byte data) { putByte(atL(ea, 1), data); }
+    final short readShortL(long ea) {
+        short v = getShort(atL(ea, 2));
+        return BE ? Short.reverseBytes(v) : v;
+    }
+    final void writeShortL(long ea, short data) {
+        putShort(atL(ea, 2), BE ? Short.reverseBytes(data) : data);
+    }
+    final int readIntL(long ea) {
+        int v = getInt(atL(ea, 4));
+        return BE ? Integer.reverseBytes(v) : v;
+    }
+    final void writeI32L(long ea, int data) {
+        putInt(atL(ea, 4), BE ? Integer.reverseBytes(data) : data);
+    }
+    final long readLongL(long ea) {
+        long v = getLong(atL(ea, 8));
+        return BE ? Long.reverseBytes(v) : v;
+    }
+    final void writeLongL(long ea, long data) {
+        putLong(atL(ea, 8), BE ? Long.reverseBytes(data) : data);
+    }
+
