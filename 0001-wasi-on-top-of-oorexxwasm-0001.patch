diff -ruN oorexx.ref/interpreter/platform/unix/SystemInterpreter.cpp oorexx/interpreter/platform/unix/SystemInterpreter.cpp
--- oorexx.ref/interpreter/platform/unix/SystemInterpreter.cpp
+++ oorexx/interpreter/platform/unix/SystemInterpreter.cpp
@@ -143,6 +143,12 @@
 
 void SystemInterpreter::startInterpreter()
 {
+#if defined(__wasi__)
+    // WASI preview 1 has no sigaction(); its emulated signal() only delivers
+    // signals the program raises itself, so there is nothing more to set up.
+    signal(SIGINT, signalHandler);
+    signal(SIGTERM, signalHandler);
+#else
 
     /* Set the cleanup handler for unconditional process termination          */
     struct sigaction new_action;
@@ -172,6 +178,7 @@
     // Set SIGPIPE to ignore so that ADDRESS WITH pipes or rxsock sockets
     // may return EPIPE error codes instead of the interpreter being killed
     signal(SIGPIPE, SIG_IGN);
+#endif
 }
 
 
