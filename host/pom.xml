<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>rexxjvm</groupId><artifactId>rexxjvm</artifactId><version>0.1</version>
  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <endive.version>1.2.0</endive.version>
    <!-- Endive's compiler with its call_indirect dispatch in smaller methods, installed in the
         local Maven repository by scripts/endive-compiler.sh (host/chicory-patch/README.md) -->
    <endive.compiler.version>1.2.0-orx1</endive.compiler.version>
    <!-- true: leave Endive's call_indirect dispatch as it is (static-table/README.md) -->
    <static.table.skip>false</static.table.skip>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency><groupId>run.endive</groupId><artifactId>runtime</artifactId><version>${endive.version}</version></dependency>
    <dependency><groupId>run.endive</groupId><artifactId>wasi</artifactId><version>${endive.version}</version></dependency>
    <!-- the compiler brings ASM, which rexxjvm.Natives uses too -->
    <dependency><groupId>run.endive</groupId><artifactId>compiler</artifactId><version>${endive.compiler.version}</version></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version>
      <executions><execution><phase>package</phase><goals><goal>shade</goal></goals>
        <configuration><transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>rexxjvm.RunWasm</mainClass>
          <!-- the jar is also a Java agent (-javaagent:rexxj.jar): native methods implemented in the module, rexxjvm.Natives -->
          <manifestEntries><Multi-Release>true</Multi-Release><Premain-Class>rexxjvm.Natives</Premain-Class><Agent-Class>rexxjvm.Natives</Agent-Class></manifestEntries></transformer></transformers></configuration>
      </execution></executions></plugin>
  </plugins></build>
  <!-- mvn package -Pembedded -Dwasm.file=/path/to/rexx.wasm: rexx.wasm translated to
       JVM bytecode at build time (Endive's build-time compiler) and embedded in the jar -->
  <profiles>
    <!-- Built with JDK 22 or later: src/main/java22 compiled for Java 22 into the jar's
         META-INF/versions/22 (a multi-release jar), so that Java 22+ can fall back to a
         FlatMemory block without sun.misc.Unsafe when the JVM refuses it (rexxjvm.Blocks).
         Built with an older JDK the jar has no such fallback, and stops working on a JVM
         that denies Unsafe's memory access. build.sh picks a JDK 22+ for Maven if it finds one. -->
    <profile>
      <id>java22</id>
      <activation><jdk>[22,)</jdk></activation>
      <build><plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
          <executions><execution><id>java22</id><phase>compile</phase><goals><goal>compile</goal></goals>
            <configuration>
              <release>22</release>
              <compileSourceRoots><compileSourceRoot>${project.basedir}/src/main/java22</compileSourceRoot></compileSourceRoots>
              <multiReleaseOutput>true</multiReleaseOutput>
            </configuration>
          </execution></executions></plugin>
      </plugins></build>
    </profile>
    <profile>
      <id>embedded</id>
      <build>
        <finalName>rexxj</finalName>
        <plugins>
          <plugin><groupId>run.endive</groupId><artifactId>endive-compiler-maven-plugin</artifactId><version>${endive.version}</version>
            <dependencies><dependency><groupId>run.endive</groupId><artifactId>compiler</artifactId><version>${endive.compiler.version}</version></dependency></dependencies>
            <executions><execution><goals><goal>compile</goal></goals>
              <configuration>
                <name>rexxjvm.RexxModule</name>
                <wasmFile>${wasm.file}</wasmFile>
                <interpreterFallback>WARN</interpreterFallback>
              </configuration>
            </execution></executions></plugin>
          <!-- the call_indirect dispatch resolved at build time when the module's table never
               changes (static-table/README.md): rewrites the classes above in target/classes -->
          <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
            <executions><execution><id>static-table</id><phase>process-classes</phase><goals><goal>exec</goal></goals>
              <configuration>
                <skip>${static.table.skip}</skip>
                <executable>${java.home}/bin/java</executable>
                <arguments>
                  <argument>-cp</argument><classpath/>
                  <argument>${project.basedir}/static-table/StaticTable.java</argument>
                  <argument>${project.build.outputDirectory}</argument>
                  <argument>${wasm.file}</argument>
                  <argument>rexxjvm/RexxModuleMachine</argument>
                </arguments>
              </configuration>
            </execution></executions></plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
